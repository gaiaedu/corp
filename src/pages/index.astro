---
import MainLayout from '../layouts/MainLayout.astro';
import {
  getSliders,
  getWorks,
  getInformationList,
  getInformationCategory,
  formatDate,
  getSlug,
  withBase,
} from '../lib/microcms';

const sliderEntries = await getSliders();
const workEntries = await getWorks();
const allInformation = await getInformationList();
const informationEntries = allInformation.slice(0, 5);
---
<MainLayout
  title="GAIA EDUCATION for CORPORATION | 株式会社ガイアエデュケーション"
  keywords="パソコンデスク,ICT,オフィス,官公庁,モニタ昇降,PC収納,PC保管,PCセキュリティ,ガイアエデュケーション,コーポレーション,GAIA EDUCATION for CORPORATION"
  description="オフィス用のパソコンデスク及びPC周辺什器の製造と販売。パソコンデスクのレイアウト、搬入、運搬までトータルなサービス。"
  ogType="website"
  cssFiles={[
    '/front/css/detail.css',
    '/front/css/slick.css',
    '/front/css/slick-theme.css',
  ]}
  hidePageTitle={true}
  hideTwoColumnContainer={true}
>
  <Fragment slot="wideFreeArea">
    <!-- carousel -->
    <section>
      <div class="container-fluid carousel pb-3 pb-md-5 px-0 mv">
        {sliderEntries.length > 0 && (
          <div class="boxSize">
            <div class="slick-main1">
              {sliderEntries.map((slider, i) => (
                <div class={`carousel-item ${i === 0 ? 'active' : ''}`}>
                  {slider.url ? (
                    <a href={withBase(slider.url)}>
                      <img height="auto" class="img-fluid vw-100" alt={slider.label || ' '} data-lazy={withBase(slider.image?.url)} src={withBase(slider.image?.url)} />
                    </a>
                  ) : (
                    <img height="auto" class="img-fluid vw-100" alt={slider.label || ' '} data-lazy={withBase(slider.image?.url)} src={withBase(slider.image?.url)} />
                  )}
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>
    <!-- /.carousel -->
  </Fragment>

  <Fragment slot="cmsArea">
    <section>
      <div class="container-fluid black top">
        <div class="container">
          <div class="row">
            <div class="col-12 col-md-6 card_outer">
              <div class="card text-center">
                <div class="card-header">IT 機器収納会議テーブル</div>
                <a href={withBase('/service/table/')}> <img src={withBase('/service/product/images/table/it_01.jpg')} alt="IT 機器収納会議テーブル" class="img-fluid"/></a>
                <div class="card-body">
                  <p class="card-text text-left small">モニターやノートPC等のICT機器を収納・展開出来るIT機器収納型の会議テーブル<br>
                    面倒な配線や画像転送装置の設置などに合わせてカスタマイズ可能なモデル<br>
                    濃いカラーを基調とした高級感ある製品を中心としたラインナップ</p>
                </div>
              </div>
            </div>
            <div class="col-12 col-md-6 card_outer">
              <div class="card text-center">
                <div class="card-header">オフィス向け家具</div>
                <a href={withBase('/service/other/')}> <img src={withBase('/service/product/images/other/other_01.jpg?2103081')} alt="オフィス向け家具" class="img-fluid"/></a>
                <div class="card-body">
                  <p class="card-text text-left small">機能性の高いオフィス向け家具を中心にラインナップ<br>
                    いつも利用する家具にガイアエデュケーションならではの機能を+ONE<br>
                    <br>
                  </p>
                </div>
              </div>
            </div>
            <div class="col-12 col-md-6 card_outer">
              <div class="card text-center">
                <div class="card-header">PC 関連収納家具</div>
                <a href={withBase('/service/furniture/')}> <img src={withBase('/service/product/images/furniture/pc_01.jpg?2006051')} alt="PC 関連収納家具" class="img-fluid"/></a>
                <div class="card-body">
                  <p class="card-text text-left small">ノートPC収納に特化した製品ラインナップ<br>
                    管理方法も壁面、移動型と豊富<br>
                    コストパフォーマンスに優れたシンプルモデル </p>
                </div>
              </div>
            </div>
            <div class="col-12 col-md-6 card_outer">
              <div class="card text-center">
                <div class="card-header">OEM 製品</div>
                <a href={withBase('/service/oem/')}> <img src={withBase('/service/product/images/oem/oem_01.jpg')} alt="OEM 製品" class="img-fluid"/></a>
                <div class="card-body">
                  <p class="card-text text-left small">木製から金属製・樹脂製等幅広いオリジナル製品を企画開発<br>
                    メーカー特定製品に合わせニーズを吸い上げたオリジナル製品の製作<br>
                    御社ICT機器にプラス１の価値を提供</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </Fragment>

  <Fragment slot="wideFreeArea2">
    <!-- work -->
    {workEntries.length > 0 && (
      <section>
        <div class="container-fluid bg-black work">
          <div class="container area">
            <div class="t_icon">
              <h1 class="ud_line text-white"><span class="small">導入事例</span><br>
                WORK</h1>
            </div>

            <!-- carousel -->
            <div class="row">
              <div class="col-12">
                <div class="boxSize">
                  <ul class="slick-main3">
                    {workEntries.map((work) => (
                      <li>
                        <a href={withBase(`/work/${getSlug(work)}/`)}>
                          <img
                            src={withBase(work.list_image?.url || '/function/images/no_image.png')}
                            width="100%"
                            height="auto"
                            alt={work.label}
                            class="img-fluid"
                          />
                          <h2>{work.label}</h2>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
            <!-- /.carousel -->
          </div>
        </div>
      </section>
    )}
    <!-- /.work -->

    <!-- information -->
    {informationEntries.length > 0 && (
      <section>
        <div class="container area pb-3" id="information">
          <div class="container">
            <div class="t_icon">
              <h1 class="ud_line"><span class="small">お知らせ</span><br>
                INFORMATION</h1>
            </div>
          </div>
          <div class="row mb-5">
            <div class="col-12">
              <div class="newsLists">
                <dl class="row">
                  {informationEntries.map((info) => {
                    const cat = getInformationCategory(info.category);
                    const dateStr = formatDate(info.published_date || info.publishedAt, '-');
                    return (
                      <>
                        <dt class="col-lg-3">
                          <time datetime={dateStr} class="date">{dateStr}</time>
                          <span class={`cat ${cat.group}`}>{cat.label}</span>
                        </dt>
                        <dd class="col-lg-9">
                          <a href={withBase(`/information/${getSlug(info)}/`)}>{info.title}</a>
                        </dd>
                      </>
                    );
                  })}
                </dl>
              </div>
              <a href={withBase('/information/')}><span class="cat label-category-base float-right pb-2 pt-2">もっと見る <img src={withBase('/function/images/arrow_white.png')} width="6" height="10" alt=""/></span></a>
            </div>
          </div>
        </div>
      </section>
    )}
    <!-- /.information -->
  </Fragment>

  <Fragment slot="scripts">
    <script is:inline type="text/javascript" src={withBase('/front/js/slick.min.js')}></script>
    <script is:inline type="text/javascript" src={withBase('/front/js/front.js')}></script>
  </Fragment>
</MainLayout>
