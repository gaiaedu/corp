---
import MainLayout from '../../layouts/MainLayout.astro';
import { withBase } from '../../lib/microcms';

const bownowProductQueryKey =
  import.meta.env.PUBLIC_BOWNOW_PRODUCT_QUERY_KEY || '_bq_text_field-20261119135348948~';
---
<MainLayout
  title="お問い合わせ | GAIA EDUCATION for CORPORATION | 株式会社ガイアエデュケーション"
  keywords="お問い合わせ,パソコンデスク,ICT,オフィス,官公庁,モニタ昇降,PC収納,PC保管,PCセキュリティ,ガイアエデュケーション,コーポレーション,GAIA EDUCATION for CORPORATION"
  description="GAIA EDUCATION for CORPORATIONへのお問い合わせです。"
  cssFiles={[
    '/inquiry/detail.css',
    '/function/css/table.css',
    '/function/css/local/list05.css',
  ]}
  pageTitleSmall="お問い合わせ"
  pageTitleEn="INQUIRY"
  hideTwoColumnContainer={true}
>
  <Fragment slot="breadCrumb">
    <li class="breadcrumb-item">お問い合わせ</li>
  </Fragment>

  <Fragment slot="wideFreeArea">
    <section>
      <div class="container-fluid serviceArea">
        <div class="container">
          <div class="h_flat">
            <h2>お問い合わせ </h2>
          </div>
          <div class="row">
            <div class="col-12">
              <p>お問い合わせは、通常2日以内にご回答するように努めておりますが、内容によりお時間がかかることがございます。</p>

              <!-- 製品詳細ページから遷移してきた場合に対象製品名・型番を明示するバナー -->
              <div id="selected-product-banner" class="alert alert-secondary mb-4" style="display: none;">
                <strong>お問い合わせ対象製品：</strong>
                <span id="selected-product-text" class="ml-1"></span>
              </div>

              <!-- BowNow フォーム起動前に URL パラメータ (_bq_text_field-20261119135348948~) を正規化 -->
              <script is:inline define:vars={{ bownowProductQueryKey }}>
                (function() {
                  var params = new URLSearchParams(window.location.search);
                  var bownowKey = bownowProductQueryKey || '_bq_text_field-20261119135348948~';
                  var productVal = params.get(bownowKey) || params.get('product');
                  if (!productVal) {
                    var pName = params.get('product_name') || '';
                    var pModel = params.get('product_model') || '';
                    if (pName || pModel) {
                      productVal = pName && pModel ? (pName + '／' + pModel) : (pName || pModel);
                    }
                  }

                  if (!productVal) return;

                  // 1. 対象製品バナーの表示
                  var banner = document.getElementById('selected-product-banner');
                  var bannerText = document.getElementById('selected-product-text');
                  if (banner && bannerText) {
                    bannerText.textContent = productVal;
                    banner.style.display = 'block';
                  }

                  // 2. BowNow クエリキーがURLに無い場合は、BowNowスクリプト実行前にURLへセット
                  if (bownowKey && !params.has(bownowKey)) {
                    var newUrl = new URL(window.location.href);
                    newUrl.searchParams.set(bownowKey, productVal);
                    window.history.replaceState({}, '', newUrl.toString());
                  }
                })();
              </script>

              <!-- BowNow フォーム サイト反映コード -->
              <div id="bownow-embed-container" class="my-3">
                <script is:inline id="_bownow_cs_sid_46469a265006b1b9556b">
                var _bownow_cs_sid_46469a265006b1b9556b = document.createElement('script');
                _bownow_cs_sid_46469a265006b1b9556b.charset = 'utf-8';
                _bownow_cs_sid_46469a265006b1b9556b.src = 'https://contents.bownow.jp/forms/sid_46469a265006b1b9556b/trace.js';
                document.getElementsByTagName('head')[0].appendChild(_bownow_cs_sid_46469a265006b1b9556b);
                </script>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </Fragment>
</MainLayout>
