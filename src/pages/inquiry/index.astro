  <Fragment slot="scripts">
    <script is:inline type="text/javascript" src={withBase('/js/ajaxzip3.js')}></script>
    <script is:inline>
      /**
       * 製品詳細ページからの遷移時に URL パラメータ (?product=製品名／型番) を読み取り、
       * 1) フォームの「お問い合わせ製品名／製品型番」入力欄 (#product) への自動セット
       * 2) BowNow の URL パラメータ初期値設定 (_bq_xxx) への自動変換・iframe引き継ぎ
       * を行うスクリプト
       */
      (function() {
        var params = new URLSearchParams(window.location.search);
        var productVal = params.get('product');
        if (!productVal) {
          var pName = params.get('product_name') || '';
          var pModel = params.get('product_model') || '';
          if (pName || pModel) {
            productVal = pName && pModel ? (pName + '／' + pModel) : (pName || pModel);
          }
        }

        if (!productVal) return;

        // 1. 対象製品バナーの表示
        var banner = document.getElementById('selected-product-banner');
        var bannerText = document.getElementById('selected-product-text');
        if (banner && bannerText) {
          bannerText.textContent = productVal;
          banner.style.display = 'block';
        }

        // 2. HTMLフォームの #product 入力欄へ自動セット
        var productInput = document.getElementById('product');
        if (productInput) {
          productInput.value = productVal;
        }

        // 3. BowNow クエリキー (PUBLIC_BOWNOW_PRODUCT_QUERY_KEY) が設定されている場合、
        //    URLクエリおよびBowNowのiframeへ初期値パラメータを自動付与
        var formEl = document.getElementById('inquiry_form');
        var bownowKey = formEl ? formEl.getAttribute('data-bownow-query-key') : '';
        if (bownowKey && !params.has(bownowKey)) {
          var newUrl = new URL(window.location.href);
          newUrl.searchParams.set(bownowKey, productVal);
          window.history.replaceState({}, '', newUrl.toString());
        }
      })();
    </script>
  </Fragment>
</MainLayout>

