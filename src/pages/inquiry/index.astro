---
import MainLayout from '../../layouts/MainLayout.astro';
import { withBase } from '../../lib/microcms';

const bownowProductQueryKey =
  import.meta.env.PUBLIC_BOWNOW_PRODUCT_QUERY_KEY || '_bq_text_field-20261119135348948~';
---
<MainLayout
  title="お問い合わせ | GAIA EDUCATION for CORPORATION | 株式会社ガイアエデュケーション"
  keywords="お問い合わせ,パソコンデスク,ICT,オフィス,官公庁,モニタ昇降,PC収納,PC保管,PCセキュリティ,ガイアエデュケーション,コーポレーション,GAIA EDUCATION for CORPORATION"
  description="GAIA EDUCATION for CORPORATIONへのお問い合わせです。"
  cssFiles={[
    '/inquiry/detail.css',
    '/function/css/table.css',
    '/function/css/local/list05.css',
  ]}
  pageTitleSmall="お問い合わせ"
  pageTitleEn="INQUIRY"
  hideTwoColumnContainer={true}
>
  <Fragment slot="breadCrumb">
    <li class="breadcrumb-item">お問い合わせ</li>
  </Fragment>

  <Fragment slot="wideFreeArea">
    <section>
      <div class="container-fluid serviceArea">
        <div class="container">
          <div class="h_flat">
            <h2>お問い合わせ </h2>
          </div>
          <div class="row">
            <div class="col-12">
              <p>お問い合わせは、通常2日以内にご回答するように努めておりますが、内容によりお時間がかかることがございます。</p>

              <!-- 製品詳細ページから遷移してきた場合に対象製品名・型番を明示するバナー -->
              <div id="selected-product-banner" class="alert alert-secondary mb-4" style="display: none;">
                <strong>お問い合わせ対象製品：</strong>
                <span id="selected-product-text" class="ml-1"></span>
              </div>

              <!-- BowNow フォーム起動前に URL パラメータ (_bq_text_field-20261119135348948~) を正規化 & DOM 自動入力 -->
              <script is:inline define:vars={{ bownowProductQueryKey }}>
                (function() {
                  var params = new URLSearchParams(window.location.search);
                  var rawFieldKey = 'text_field-20261119135348948';
                  var keyWithTilde = '_bq_' + rawFieldKey + '~';
                  var keyNoTilde = '_bq_' + rawFieldKey;

                  var productVal = params.get(keyWithTilde) || params.get(keyNoTilde) || params.get('product');
                  if (!productVal) {
                    var pName = params.get('product_name') || '';
                    var pModel = params.get('product_model') || '';
                    if (pName || pModel) {
                      productVal = pName && pModel ? (pName + '／' + pModel) : (pName || pModel);
                    }
                  }

                  if (!productVal) return;

                  // 1. 対象製品バナーの表示
                  var banner = document.getElementById('selected-product-banner');
                  var bannerText = document.getElementById('selected-product-text');
                  if (banner && bannerText) {
                    bannerText.textContent = productVal;
                    banner.style.display = 'block';
                  }

                  // 2. BowNow クエリキー（チルダあり・なし両方）をURLにセット
                  var newUrl = new URL(window.location.href);
                  var urlChanged = false;
                  if (!params.has(keyWithTilde)) {
                    newUrl.searchParams.set(keyWithTilde, productVal);
                    urlChanged = true;
                  }
                  if (!params.has(keyNoTilde)) {
                    newUrl.searchParams.set(keyNoTilde, productVal);
                    urlChanged = true;
                  }
                  if (urlChanged) {
                    window.history.replaceState({}, '', newUrl.toString());
                  }

                  // 3. BowNow がフォーム要素（input / textarea）を描画した際に直接値を注入
                  function fillFormInputs() {
                    // name や id に text_field-20261119135348948 を含む input/textarea を探索
                    var inputs = document.querySelectorAll(
                      'input[name*="' + rawFieldKey + '"], textarea[name*="' + rawFieldKey + '"], ' +
                      'input[id*="' + rawFieldKey + '"], textarea[id*="' + rawFieldKey + '"]'
                    );

                    inputs.forEach(function(input) {
                      if (!input.value) {
                        input.value = productVal;
                        input.dispatchEvent(new Event('input', { bubbles: true }));
                        input.dispatchEvent(new Event('change', { bubbles: true }));
                      }
                    });

                    // iframe がある場合（同一オリジンであれば操作を試みる）
                    var iframes = document.querySelectorAll('#bownow-embed-container iframe');
                    iframes.forEach(function(iframe) {
                      try {
                        var doc = iframe.contentDocument || iframe.contentWindow.document;
                        if (doc) {
                          var frameInputs = doc.querySelectorAll(
                            'input[name*="' + rawFieldKey + '"], textarea[name*="' + rawFieldKey + '"], ' +
                            'input[id*="' + rawFieldKey + '"], textarea[id*="' + rawFieldKey + '"]'
                          );
                          frameInputs.forEach(function(input) {
                            if (!input.value) {
                              input.value = productVal;
                              input.dispatchEvent(new Event('input', { bubbles: true }));
                              input.dispatchEvent(new Event('change', { bubbles: true }));
                            }
                          });
                        }
                      } catch (e) {
                        // クロスオリジン iframe の場合はブラウザセキュリティでアクセス不可（URL パラメータで処理）
                      }
                    });
                  }

                  // レンダリング待ちのため定期的に注入を試行（最大10秒間）
                  var attempts = 0;
                  var intervalId = setInterval(function() {
                    fillFormInputs();
                    attempts++;
                    if (attempts > 20) {
                      clearInterval(intervalId);
                    }
                  }, 500);

                  window.addEventListener('load', fillFormInputs);
                })();
              </script>

              <!-- BowNow フォーム サイト反映コード -->
              <div id="bownow-embed-container" class="my-3">
                <script is:inline id="_bownow_cs_sid_46469a265006b1b9556b">
                var _bownow_cs_sid_46469a265006b1b9556b = document.createElement('script');
                _bownow_cs_sid_46469a265006b1b9556b.charset = 'utf-8';
                _bownow_cs_sid_46469a265006b1b9556b.src = 'https://contents.bownow.jp/forms/sid_46469a265006b1b9556b/trace.js';
                document.getElementsByTagName('head')[0].appendChild(_bownow_cs_sid_46469a265006b1b9556b);
                </script>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </Fragment>
</MainLayout>
