                          <div class="col-auto">〒</div>
                          <div class="col-5 col-sm-3">
                            <input type="tel" name="zip1" id="zip1" class="widthOneThird form-control" placeholder="000" onkeyup="AjaxZip3.zip2addr('zip1','zip2','prefecture','address');" required />
                          </div>
                          <div class="col-auto">-</div>
                          <div class="col-5 col-sm-3">
                            <input type="tel" name="zip2" id="zip2" class="widthOneThird form-control" placeholder="0000" onkeyup="AjaxZip3.zip2addr('zip1','zip2','prefecture','address');" required />
                          </div>
                        </div>
                      </td>
                    </tr>
                    <tr>
                      <th>都道府県<span class="text-danger">※</span></th>
                      <td>
                        <div class="form-group col-sm-6 px-0">
                          <select name="prefecture" id="prefecture" class="form-control" required>
