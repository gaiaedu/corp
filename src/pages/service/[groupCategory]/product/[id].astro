---
import MainLayout from '../../../../layouts/MainLayout.astro';
import ServiceNav4 from '../../../../components/ServiceNav4.astro';
import {
  getProductCategories,
  getProducts,
  getWorks,
  normalizeGroupKey,
  getProductGroup,
  getSlug,
  outputHtml,
  getFileIconClass,
  getFileUrl,
  withBase,
  type GroupMaster,
  type ProductCategoryItem,
  type ProductItem,
  type WorkItem,
} from '../../../../lib/microcms';

export async function getStaticPaths() {
  const allCategories = await getProductCategories();
  const allProducts = await getProducts();
  const allWorks = await getWorks();

  const categoryMap = new Map<string, ProductCategoryItem>();
  for (const cat of allCategories) {
    categoryMap.set(cat.id, cat);
    categoryMap.set(getSlug(cat), cat);
  }

  const paths = [];

  for (const product of allProducts) {
    const cat =
      (product.category && (categoryMap.get(product.category.id) || product.category)) ||
      allCategories[0];
    const gKey = normalizeGroupKey(cat?.group);
    const groupMaster = getProductGroup(gKey);
    const catSlug = getSlug(cat);
    const prodSlug = getSlug(product);

    const relatedWorks = allWorks.filter((w) =>
      (w.products || []).some((p) => p.id === product.id || getSlug(p) === prodSlug)
    );

    const groupCategoryCombos = new Set<string>([`${gKey}-${catSlug}`]);
    if (cat && cat.id !== catSlug) {
      groupCategoryCombos.add(`${gKey}-${cat.id}`);
    }

    const prodSlugs = new Set<string>([prodSlug]);
    if (product.id !== prodSlug) {
      prodSlugs.add(product.id);
    }

    for (const gc of groupCategoryCombos) {
      for (const ps of prodSlugs) {
        paths.push({
          params: { groupCategory: gc, id: ps },
          props: {
            group: groupMaster,
            category: cat,
            model: product,
            works: relatedWorks,
          },
        });
      }
    }
  }

  return paths;
}

interface Props {
  group: GroupMaster;
  category: ProductCategoryItem;
  model: ProductItem;
  works: WorkItem[];
}

const { group, category, model, works } = Astro.props;
const isTempGroup = group.name === 'temp';

const title = isTempGroup
  ? `${model.name} | サービス | GAIA EDUCATION for CORPORATION | 株式会社ガイアエデュケーション`
  : `${model.name} | ${category.name} | ${group.label} | サービス | GAIA EDUCATION for CORPORATION`;

const keywords = isTempGroup
  ? `${model.name},サービス,パソコンデスク,ICT,オフィス,官公庁,モニタ昇降,PC収納,PC保管,PCセキュリティ,ガイアエデュケーション,コーポレーション,GAIA EDUCATION for CORPORATION`
  : `${model.name},${category.name},${group.label},サービス,パソコンデスク,ICT,オフィス,官公庁,モニタ昇降,PC収納,PC保管,PCセキュリティ,ガイアエデュケーション,コーポレーション,GAIA EDUCATION for CORPORATION`;

const description = `GAIA EDUCATION for CORPORATIONのサービス ${model.name} です。`;

const descriptions = (model.descriptions || []).filter((d) => d.title);
const files = (model.files || []).filter((f) => f.file);
const functions = (model.functions || []).filter((fn) => fn.title);
const options = (model.options || []).filter((op) => op.title);
const specs = (model.specs || []).filter((s) => s.title);
const sites = (model.sites || []).filter((s) => s.url);
const links = (model.links || []).filter((l) => l.code);

const productInquiryLabel = `${model.name}／${model.model}`;
const rawFieldKey = 'text_field-20261119135348948';
const encodedLabel = encodeURIComponent(productInquiryLabel);
// BowNow の仕様差異（末尾チルダ~の有無）の両方に対応するため、両方のキーをパラメータに付与
const inquiryUrl = withBase(
  `/inquiry/?_bq_${rawFieldKey}~=${encodedLabel}&_bq_${rawFieldKey}=${encodedLabel}&product=${encodedLabel}`
);
---
<MainLayout
  title={title}
  keywords={keywords}
  description={description}
  cssFiles={[
    '/service/detail.css',
    '/function/css/table.css',
    `/function/css/local/${group.group}.css`,
  ]}
  pageTitleSmall="サービス"
  pageTitleEn="SERVICE"
  hideTwoColumnContainer={true}
>
  <Fragment slot="breadCrumb">
    <li class="breadcrumb-item"><a href={withBase('/service/')}>サービス</a></li>
    {!isTempGroup && (
      <>
        <li class="breadcrumb-item"><a href={withBase(`/service/${group.name}/`)}>{group.label}</a></li>
        <li class="breadcrumb-item"><a href={withBase(`/service/${group.name}-${getSlug(category)}/`)}>{category.name}</a></li>
      </>
    )}
    <li class="breadcrumb-item">{model.name}</li>
  </Fragment>

  <Fragment slot="wideFreeArea">
    <!-- 製品のお問い合わせフローティングボタン -->
    <nav>
      <ul class="sideLinkList">
        <li>
          <a href={inquiryUrl}><img src={withBase('/function/images/arrow_product.svg')} alt="" width="18"/>製品のお問い合わせ</a>
        </li>
      </ul>
    </nav>

    <ServiceNav4 />

    <section>
      <div class="container serviceArea">
        <div class="h_flat">
          <h2>{model.name}</h2>
        </div>
        <div class="row">
          <div class="col-12">
            <img
              src={withBase(model.main_image?.url || '/function/images/no_image.png')}
              width="1140"
              alt={model.name}
              class="img-fluid img-inside-border"
            />
          </div>
          {model.body && (
            <div class="col-12 ">
              <p class="bg-gray2" set:html={outputHtml(model.body)} />
            </div>
          )}
          {model.youtube_id && (
            <div class="col-12 videoBox">
              <div class="video-container">
                <iframe width="1280" height="760" src={`https://www.youtube.com/embed/${model.youtube_id}`} frameborder="0" allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
              </div>
              <p class="caption">{model.youtube_caption}</p>
            </div>
          )}
          {(model.model || descriptions.length > 0) && (
            <div class="col-12">
              <table width="100%">
                <tbody>
                  <tr>
                    <th scope="row">製品型番</th>
                    <td>{model.model}</td>
                  </tr>
                  {descriptions.map((desc) => (
                    <tr>
                      <th scope="row">{desc.title}</th>
                      <td set:html={outputHtml(desc.body)} />
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </div>
      </div>
    </section>

    {files.length > 0 && (
      <section>
        <div class="container mb-5">
          <div class="h_flat">
            <h2>関連ファイルダウンロード</h2>
          </div>
          <div class="row">
            <div class="col-12 basic mb-t">
              <ul>
                {files.map((item) => (
                  <li>
                    <a href={getFileUrl(item.file)} target="_blank" rel="noopener noreferrer">{item.title || 'ファイルダウンロードはこちら'}</a>
                    {' '}<i class={getFileIconClass(item.file)}></i>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </section>
    )}

    {functions.length > 0 && (
      <section>
        <div class="container serviceArea">
          <div class="h_flat">
            <h2>機能</h2>
          </div>
          <div class="row">
            {functions.map((fn) => (
              <div class="col-12 col-md-6 card_outer">
                <div class="card">
                  <div class="card-header">{fn.title}</div>
                  <img src={withBase(fn.image?.url || '/function/images/no_image.png')} alt={fn.title} class="img-fluid"/>
                  <div class="card-body">
                    <p class="card-text small" set:html={outputHtml(fn.image_caption)} />
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    {options.length > 0 && (
      <section>
        <div class="container serviceArea">
          <div class="h_flat">
            <h2>オプション</h2>
          </div>
          <div class="row">
            {options.map((op) => (
              <div class="col-12 col-md-6 card_outer">
                <div class="card">
                  <div class="card-header">{op.title}</div>
                  <img src={withBase(op.image?.url || '/function/images/no_image.png')} alt={op.title} class="img-fluid"/>
                  <div class="card-body">
                    <p class="card-text small" set:html={outputHtml(op.image_caption)} />
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    {works.length > 0 && (
      <section>
        <div class="container serviceArea">
          <div class="h_flat">
            <h2>導入事例</h2>
          </div>
          <div class="row">
            {works.map((work) => (
              <div class="col-12 col-md-6 card_outer">
                <div class="card">
                  <div class="card-header">{work.label}</div>
                  <a href={withBase(`/work/${getSlug(work)}/`)}>
                    <img src={withBase(work.list_image?.url || '/function/images/no_image.png')} alt={work.label} class="img-fluid"/>
                  </a>
                  <div class="card-body">
                    <p class="card-text small" set:html={outputHtml(work.list_image_caption)} />
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    {specs.length > 0 && (
      <section>
        <div class="container serviceArea">
          <div class="h_flat">
            <h2>仕様</h2>
          </div>
          <div class="row">
            <div class="col-12">
              <table width="100%">
                <tbody>
                  {specs.map((spec) => (
                    <tr>
                      <th scope="row">{spec.title}</th>
                      <td set:html={outputHtml(spec.body)} />
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </section>
    )}

    {(sites.length > 0 || links.length > 0 || model.amazon_url) && (
      <section>
        <div class="container mb-5">
          <div class="h_flat">
            <h2>関連サイト</h2>
          </div>
          <div class="row">
            <div class="col-12 basic mb-t">
              <ul>
                {sites.map((site) => (
                  <li>
                    <a href={site.url} target="_blank" rel="noopener noreferrer">
                      {site.title || '関連サイトはこちら'} <i class="fas fa-external-link-square-alt"></i>
                    </a>
                  </li>
                ))}
                {links.map((lnk) => (
                  <li>
                    <Fragment set:html={lnk.code} /> <i class="fas fa-external-link-square-alt"></i>
                  </li>
                ))}
              </ul>
            </div>
            {model.amazon_url && (
              <div class="col-12">
                <div class="text-center">
                  <a href={model.amazon_url} target="_blank" rel="noopener noreferrer" class="btn-gradient-flat mt-5">
                    <img src={withBase('/function/images/amazon_logo.svg')} height="24" alt="" class="img-fluid"/>アマゾンで購入する！
                  </a>
                </div>
              </div>
            )}
          </div>
        </div>
      </section>
    )}
  </Fragment>
</MainLayout>
