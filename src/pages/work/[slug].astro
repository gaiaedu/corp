---
import MainLayout from '../../layouts/MainLayout.astro';
import WorkNav4 from '../../components/WorkNav4.astro';
import {
  getWorks,
  getProducts,
  getProductCategories,
  WORK_CATEGORIES,
  normalizeGroupKey,
  getWorkCategory,
  getSlug,
  outputHtml,
  getFileIconClass,
  getFileUrl,
  withBase,
  type WorkItem,
  type ProductItem,
} from '../../lib/microcms';

export async function getStaticPaths() {
  const allWorks = await getWorks();
  const allProducts = await getProducts();
  const allCategories = await getProductCategories();

  const productMap = new Map<string, ProductItem>();
  for (const p of allProducts) {
    productMap.set(p.id, p);
    productMap.set(getSlug(p), p);
  }

  const categoryMap = new Map();
  for (const c of allCategories) {
    categoryMap.set(c.id, c);
    categoryMap.set(getSlug(c), c);
  }

  const paths = [];

  const catKeys = ['table', 'other', 'furniture', 'oem'] as const;
  for (const cKey of catKeys) {
    const catMaster = WORK_CATEGORIES[cKey];
    const entries = allWorks.filter((w) => {
      const k = normalizeGroupKey(w.category);
      return cKey === 'table' ? k === 'table' || k === 'temp' : k === cKey;
    });
    paths.push({
      params: { slug: cKey },
      props: {
        pageType: 'category' as const,
        category: catMaster,
        entries,
        model: null,
        relatedProducts: [],
      },
    });
  }

  for (const work of allWorks) {
    const catMaster = getWorkCategory(work.category);
    const workSlug = getSlug(work);

    const relatedProducts: { product: ProductItem; url: string }[] = [];
    for (const refProd of work.products || []) {
      const fullProd = productMap.get(refProd.id) || productMap.get(getSlug(refProd)) || refProd;
      const cat =
        (fullProd.category && (categoryMap.get(fullProd.category.id) || fullProd.category)) ||
        allCategories[0];
      const gKey = normalizeGroupKey(cat?.group);
      const catSlug = getSlug(cat);
      const prodSlug = getSlug(fullProd);
      relatedProducts.push({
        product: fullProd,
        url: `/service/${gKey}-${catSlug}/product/${prodSlug}/`,
      });
    }

    paths.push({
      params: { slug: workSlug },
      props: {
        pageType: 'detail' as const,
        category: catMaster,
        entries: [],
        model: work,
        relatedProducts,
      },
    });

    if (work.id !== workSlug) {
      paths.push({
        params: { slug: work.id },
        props: {
          pageType: 'detail' as const,
          category: catMaster,
          entries: [],
          model: work,
          relatedProducts,
        },
      });
    }
  }

  return paths;
}

interface Props {
  pageType: 'category' | 'detail';
  category: { name: string; label: string; group: string };
  entries: WorkItem[];
  model: WorkItem | null;
  relatedProducts: { product: ProductItem; url: string }[];
}

const { pageType, category, entries, model, relatedProducts } = Astro.props;

const title =
  pageType === 'category'
    ? `${category.label} | 導入事例 | GAIA EDUCATION for CORPORATION | 株式会社ガイアエデュケーション`
    : `${model!.label} | ${category.label} | 導入事例 | GAIA EDUCATION for CORPORATION | 株式会社ガイアエデュケーション`;

const keywords =
  pageType === 'category'
    ? `${category.label},導入事例,パソコンデスク,ICT,オフィス,官公庁,モニタ昇降,PC収納,PC保管,PCセキュリティ,ガイアエデュケーション,コーポレーション,GAIA EDUCATION for CORPORATION`
    : `${model!.label},${category.label},導入事例,パソコンデスク,ICT,オフィス,官公庁,モニタ昇降,PC収納,PC保管,PCセキュリティ,ガイアエデュケーション,コーポレーション,GAIA EDUCATION for CORPORATION`;

const description =
  pageType === 'category'
    ? `GAIA EDUCATION for CORPORATIONの導入事例 ${category.label} です。`
    : `GAIA EDUCATION for CORPORATIONの導入事例 ${model!.label} です。`;

const subImages = model ? (model.sub_images || []).filter((img) => img.image?.url) : [];
const files = model ? (model.files || []).filter((f) => f.file) : [];
const sites = model ? (model.sites || []).filter((s) => s.url) : [];
---
<MainLayout
  title={title}
  keywords={keywords}
  description={description}
  cssFiles={[
    '/work/detail.css',
    '/function/css/table.css',
    `/function/css/local/${category.group}.css`,
  ]}
  pageTitleSmall="導入事例"
  pageTitleEn="WORK"
  hideTwoColumnContainer={true}
>
  <Fragment slot="breadCrumb">
    <li class="breadcrumb-item"><a href={withBase('/work/')}>導入事例</a></li>
    {pageType === 'category' ? (
      <li class="breadcrumb-item">{category.label}</li>
    ) : (
      <>
        <li class="breadcrumb-item"><a href={withBase(`/work/${category.name}/`)}>{category.label}</a></li>
        <li class="breadcrumb-item">{model!.label}</li>
      </>
    )}
  </Fragment>

  <Fragment slot="wideFreeArea">
    <WorkNav4 />
  </Fragment>

  <Fragment slot="cmsArea">
    {pageType === 'category' ? (
      <section>
        <div class="container-fluid serviceArea">
          <div class="container">
            <div class="h_flat">
              <h2>{category.label}</h2>
            </div>
            <div class="row">
              {entries.map((work) => (
                <div class="col-12 col-md-6 card_outer">
                  <div class="card">
                    <div class="card-header">{work.label}</div>
                    <a href={withBase(`/work/${getSlug(work)}/`)}>
                      <img
                        src={withBase(work.list_image?.url || '/function/images/no_image.png')}
                        alt={work.label}
                        class="img-fluid"
                      />
                    </a>
                    <div class="card-body">
                      <p class="card-text small">
                        {work.list_image_caption}
                      </p>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>
    ) : (
      <>
        <section>
          <div class="container serviceArea">
            <div class="h_flat">
              <h2>{model!.label}</h2>
            </div>
            <div class="row">
              {model!.main_image?.url && (
                <div class="col-12">
                  <img src={withBase(model!.main_image.url)} width="100%" height="auto" alt={model!.label} class="img-fluid"/>
                  {model!.main_image_caption && (
                    <p class="caption">{model!.main_image_caption}</p>
                  )}
                </div>
              )}
              {model!.body && (
                <div class="col-12 ">
                  <p class="bg-gray2" set:html={outputHtml(model!.body)} />
                </div>
              )}
              {model!.youtube_id && (
                <div class="col-12 videoBox">
                  <div class="video-container">
                    <iframe width="1280" height="760" src={`https://www.youtube.com/embed/${model!.youtube_id}`} frameborder="0" allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                  </div>
                  {model!.youtube_caption && (
                    <p class="caption">{model!.youtube_caption}</p>
                  )}
                </div>
              )}
              {subImages.length > 0 && subImages.map((img) => (
                <div class="col-6">
                  <img src={withBase(img.image!.url)} alt={img.caption || ''} class="img-fluid"/>
                  {img.caption && (
                    <p class="caption">{img.caption}</p>
                  )}
                </div>
              ))}
            </div>
          </div>
        </section>

        {files.length > 0 && (
          <section>
            <div class="container mb-5">
              <div class="h_flat">
                <h2>ファイルダウンロード</h2>
              </div>
              <div class="row">
                <div class="col-12 basic mb-t">
                  <ul>
                    {files.map((item) => (
                      <li>
                        <a href={getFileUrl(item.file)} target="_blank" rel="noopener noreferrer">{item.title || 'ファイルダウンロードはこちら'}</a>
                        {' '}<i class={getFileIconClass(item.file)}></i>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          </section>
        )}

        {sites.length > 0 && (
          <div class="container mb-5">
            <div class="h_flat">
              <h2>関連リンク</h2>
            </div>
            <div class="row">
              <div class="col-12 basic mb-t">
                <ul>
                  {sites.map((site) => (
                    <li>
                      <a href={site.url} target="_blank" rel="noopener noreferrer">
                        {site.title || '関連サイトはこちら'} <i class="fas fa-external-link-square-alt"></i>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        )}

        {relatedProducts.length > 0 && (
          <section>
            <div class="container-fluid serviceArea">
              <div class="container">
                <div class="h_flat">
                  <h2>製品</h2>
                </div>
                <div class="row">
                  {relatedProducts.map(({ product, url }) => (
                    <div class="col-12 col-md-6 card_outer">
                      <div class="card">
                        <div class="card-header">{product.name}</div>
                        <a href={withBase(url)}>
                          <img
                            src={withBase(product.list_image?.url || '/function/images/no_image.png')}
                            alt={product.name}
                            class="img-fluid"
                          />
                        </a>
                        <div class="card-body">
                          <p class="card-text small">{product.list_image_caption}</p>
                        </div>
                      </div>
                    </div>
                  ))}
                  <div class="col-12"> </div>
                </div>
              </div>
            </div>
          </section>
        )}
      </>
    )}
  </Fragment>
</MainLayout>
